{
  "openapi": "3.0.0",
  "info": {
    "title": "User Service",
    "version": "2.0.0"
  },
  "paths": {
    "/users/{id}": {
      "get": {
        "summary": "Get a single user",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "email_address": { "type": "string" },
                    "name": { "type": "string" },
                    "is_active": { "type": "boolean" },
                    "signup_date": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}